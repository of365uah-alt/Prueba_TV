import json
import random
import pathlib


class Game:

    def __init__(self):
        # Cargar archivos

        BASE_DIR = pathlib.Path(__file__).parent
        path_stages = BASE_DIR / "Stages.json"
        path_text = BASE_DIR / "Text.json"

        with open(path_stages, "r", encoding="utf-8") as f:
            self.stages = json.load(f)

        with open(path_text, "r", encoding="utf-8") as f:
            self.text = json.load(f)

        self.stages = json.load(open(path_stages, "r"))
        self.text = json.load(open(path_text, "r"))

        self.player = Player("Guard")

    def inicio(self):
        print("Hi welcome to Freddy Fazbear Pizza")
        print("All rights reserved by Fazbear Entertainment")
        print("You will have to stay until morning")
        print("May god be upon you")

    def ciclo_avanzar(self):

        for _ in range(2):

            random_generator = random.randint(0, 5)
            advance_stage = random.randint(0, 1)

            if advance_stage == 0:
                continue

            animatronics = ["chica", "bonnie", "freddy", "foxy"]

            if random_generator < 4:
                name = animatronics[random_generator]
                self.stages[name] += 1

                if self.stages[name] >= 5:
                    break

            # puppet siempre avanza si advance_stage == 1
            self.stages["puppet"] += 1

            if self.stages["puppet"] >= 5:
                break

    def consecuencias(self):

        for name in ["puppet", "foxy", "chica", "bonnie", "freddy"]:
            if self.stages[name] > 5:
                print(self.text[name]["death"])
                return True

        return False

    def help(self):
        print("You can do the following actions:")
        print("b -> wind the music box")
        print("l -> check the left vent")
        print("r -> check the right vent")
        print("h -> check the hall")
        print("m -> put on the mask")

    def game_loop(self):

        self.inicio()

        while True:

            self.player.acciones(self)

            self.ciclo_avanzar()

            if self.consecuencias():
                break


class Player:

    def __init__(self, name):

        self.name = name

        self.mask_on = False
        self.left_vent_closed = False
        self.right_vent_closed = False

        self.flash_right_vent = False
        self.flash_left_vent = False
        self.flash_hall = False

    def acciones(self, game):

        for _ in range(3):

            action = input("Select your action (help for controls): ")

            if action == "help":
                game.help()

            elif action == "b":

                print("Music box wound")

                game.stages["puppet"] = max(0, game.stages["puppet"] - 2)

            elif action == "m":

                print("Mask on")

                self.mask_on = True

            elif action == "l":

                print("Checking left vent")

                sub = input("c = close vent / f = flashlight: ")

                if sub == "c":
                    self.left_vent_closed = True

                elif sub == "f":
                    self.flash_left_vent = True

            elif action == "r":

                print("Checking right vent")

                sub = input("c = close vent / f = flashlight: ")

                if sub == "c":
                    self.right_vent_closed = True

                elif sub == "f":
                    self.flash_right_vent = True

            elif action == "h":

                print("Checking hall")

                sub = input("f = flashlight: ")

                if sub == "f":
                    self.flash_hall = True



if __name__ == "__main__":

    game = Game()
    game.game_loop()