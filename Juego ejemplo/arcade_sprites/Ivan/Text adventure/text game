def cicloAvanzar():
    for i in range(0,2):
        randomGenerator = random.randint(0,5)
        advanceStage = random.randint(0,1)
        if(randomGenerator == 0):
            if(advanceStage == 1):
                Stages["chica"] += 1
                if(Stages["chica"]==5): break

        elif(randomGenerator == 1):
            if(advanceStage == 1):
                Stages["bonnie"] += 1
                if(Stages["bonnie"]==5): break

        elif(randomGenerator == 2):
            if(advanceStage == 1):
                Stages["freddy"] += 1
                if(Stages["freddy"]==5): break
        elif(randomGenerator == 3):
            if(advanceStage == 1):
                Stages["foxy"] += 1
                if(Stages["foxy"]==5): break
        if(advanceStage == 1 ):
            Stages["puppet"] += 1
            if(Stages["puppet"]==5): break 
            


